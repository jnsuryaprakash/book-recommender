# Copy this file to .env and fill in your own values. Never commit .env.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# OverDrive/Libby library key. Find yours by visiting
#   https://libbyapp.com → choose your library → URL becomes
#   libbyapp.com/library/<KEY>
# Examples:
#   plano   — Plano Public Library (TX)
#   lib2go  — Bentonville Public Library (AR)
#   nypl    — New York Public Library
LIBRARY_KEY=plano

# Public URL of your reading-history page. The default parser expects a
# Blogger post with a <ol><li>Title - Author</li></ol> structure.
READS_URL=https://jnsuryaprakash.blogspot.com/2009/03/books-i-read.html

# Claude model used by the LLM re-ranker
CHAT_MODEL=claude-opus-4-7

# Polite rate limit for the OverDrive Thunder API (seconds between requests)
FETCH_DELAY=1.0
